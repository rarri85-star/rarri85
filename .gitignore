# Obsidian workspace state (machine-specific, should not sync via git)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Plugin data that may contain sensitive info or machine-specific state
.obsidian/plugins/*/data.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary / editor files
*.tmp
*.temp
~$*

